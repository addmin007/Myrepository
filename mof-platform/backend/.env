# backend/.env — 本地开发环境变量（不提交到 git）
APP_NAME=MOF Prediction Platform
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 模型路径（本地直接运行时使用绝对路径）
CKPT_1BAR=/Users/heyouqi/Desktop/Uni-MOF-main/results/S1_1bar_lora/checkpoint_best.pt
CKPT_HIGHP=/Users/heyouqi/Desktop/Uni-MOF-main/paper_data/model/checkpoint_best.pt
DICT_PATH=/Users/heyouqi/Desktop/Uni-MOF-main/Uni-MOF-main/lmdb_s1_fixed/dict.txt
UNIMOF_DIR=/Users/heyouqi/Desktop/Uni-MOF-main/Uni-MOF-main/unimof

# 推理设备（auto=自动选 CUDA/MPS/CPU）
# 注意：Celery Worker 在 macOS 上使用 solo pool（避免 fork），auto 可用 MPS
# 但若 Worker 端 MPS 仍有问题，可改为 cpu
DEVICE=auto
FP16=false
MAX_ATOMS=512

# Redis
REDIS_URL=redis://localhost:6379/0

# 压力路由阈值
PRESSURE_THRESHOLD_BAR=2.0
