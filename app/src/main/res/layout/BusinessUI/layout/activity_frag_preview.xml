<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/main_bg"
    tools:context=".View.BusinessUI.Fragment.Preview.FragPreview">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 单台摄像机整屏幕显示区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_margin="4dp"
        android:background="@drawable/list_background">

        <!-- 摄像机视频显示 -->
        <SurfaceView
            android:id="@+id/preview_surface_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        
        <!-- 设备信息显示 -->
        <TextView
            android:id="@+id/device_name_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:background="#80000000"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="16dp"
            android:text="正在连接摄像机..."
            android:visibility="visible" />
        
        <!-- 设备IP显示 -->
        <TextView
            android:id="@+id/device_ip_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="#80000000"
            android:textColor="#00F5FF"
            android:textSize="14sp"
            android:padding="16dp"
            android:text=""
            android:visibility="visible" />
        
        <!-- 连接状态指示器 -->
        <TextView
            android:id="@+id/connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:background="#80000000"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:padding="12dp"
            android:text="● 在线"
            android:visibility="gone" />

        <!-- 摄像机控制按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:orientation="horizontal"
            android:padding="16dp">

            <Button
                android:id="@+id/btn_refresh_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="刷新"
                android:textSize="12sp"
                android:background="@drawable/tech_button_background"
                android:textColor="@color/tab_active_text" />

        </LinearLayout>

    </FrameLayout>

    <!-- 云台控制区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="4dp"
        android:background="@drawable/list_background"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="云台控制"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:textColor="@color/primary_text"
            android:gravity="center" />

        <!-- 云台控制按钮组 -->
        <RelativeLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp">

            <!-- 中心圆 -->
            <View
                android:id="@+id/ptz_center"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_centerInParent="true"
                android:background="@drawable/tech_button_background" />

            <!-- 上 -->
            <Button
                android:id="@+id/btn_ptz_up"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_above="@id/ptz_center"
                android:layout_centerHorizontal="true"
                android:text="▲"
                android:textSize="24sp"
                android:textColor="@color/tab_active_text"
                android:background="@drawable/tech_button_background" />

            <!-- 下 -->
            <Button
                android:id="@+id/btn_ptz_down"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_below="@id/ptz_center"
                android:layout_centerHorizontal="true"
                android:text="▼"
                android:textSize="24sp"
                android:textColor="@color/tab_active_text"
                android:background="@drawable/tech_button_background" />

            <!-- 左 -->
            <Button
                android:id="@+id/btn_ptz_left"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_toLeftOf="@id/ptz_center"
                android:layout_centerVertical="true"
                android:text="◀"
                android:textSize="24sp"
                android:textColor="@color/tab_active_text"
                android:background="@drawable/tech_button_background" />

            <!-- 右 -->
            <Button
                android:id="@+id/btn_ptz_right"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_toRightOf="@id/ptz_center"
                android:layout_centerVertical="true"
                android:text="▶"
                android:textSize="24sp"
                android:textColor="@color/tab_active_text"
                android:background="@drawable/tech_button_background" />

        </RelativeLayout>

        <!-- 变焦控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btn_zoom_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="放大 +"
                android:textSize="14sp"
                android:textColor="@color/tab_active_text"
                android:background="@drawable/tech_button_background"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btn_zoom_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="缩小 -"
                android:textSize="14sp"
                android:textColor="@color/tab_active_text"
                android:background="@drawable/tech_button_background" />

        </LinearLayout>

    </LinearLayout>

    <!-- 底部信息区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="4dp"
        android:background="@drawable/list_background">

        <!-- 作业人员信息 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="作业人员"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:textColor="@color/primary_text" />

        <LinearLayout
            android:id="@+id/worker_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:weightSum="5" />

        <!-- 气体浓度信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前气体浓度: "
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/gas_concentration"
                android:layout_width="wrap_content"
        android:layout_height="wrap_content"
                android:text="56 PPM"
                android:textSize="14sp"
                android:textColor="@color/tech_accent"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

</ScrollView>
