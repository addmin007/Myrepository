<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- 科技感卡片背景 -->
    <solid android:color="#1E3A5F"/>
    
    <!-- 边框光效 -->
    <stroke 
        android:width="1dp" 
        android:color="#00F5FF"/>
    
    <!-- 圆角 -->
    <corners android:radius="12dp"/>
    
    <!-- 阴影效果 -->
    <padding 
        android:left="16dp" 
        android:right="16dp" 
        android:top="16dp" 
        android:bottom="16dp"/>
        
</shape>

